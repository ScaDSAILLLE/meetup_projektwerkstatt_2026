# ─────────────────────────────────────────────────────────────────────────────
# ScaDS.AI SmolAgents Projektwerkstatt — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# Usage:
#   uv sync
#   cp .env.example .env
#   $EDITOR .env        # optional: override server bind / port
#   uv run app.py
#
# Lines starting with `#` are comments. Empty values fall back to the
# defaults documented in `config.py`.
#
# DO NOT COMMIT your `.env`. `.gitignore` excludes it; only this
# `.env.example` template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# Gradio server bind / port. Use 0.0.0.0 for container / LAN exposure,
# 127.0.0.1 for local-only development.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# ─────────────────────────────────────────────────────────────────────────────
# ScaDS.AI API (erforderlich für Flyer-Generator-Agent)
# ─────────────────────────────────────────────────────────────────────────────
# API-Key vom ScaDS.AI Self-Service Portal:
#   https://selfservice.tu-dresden.de/services/scads-llm-api/
SCADSAI_API_KEY= 

# API Base URL (Default: https://llm.scads.ai/v1)
SCADSAI_API_BASE=https://llm.scads.ai/v1

# Chat-Modell für Reasoning, Tool-Auswahl und Prompt-Enhancement.
# Alternativen: alias-huge, alias-code, alias-reasoning
SCADSAI_CHAT_MODEL=alias-vision

# Image-Modell für Flyer-Bildgenerierung
SCADSAI_IMAGE_MODEL=alias-image-generation

# Stärkeres Modell für den Orchestrator-Agenten (Routing, Meta-Fragen)
SCADSAI_ORCHESTRATOR_MODEL=google/gemma-4-26B-A4B-it

# Request-Timeout in Sekunden
SCADSAI_REQUEST_TIMEOUT=60

# Verzeichnis für generierte Bilder (Default: runtime_data/generated_images)
# GENERATED_IMAGES_DIR=./runtime_data/generated_images

# Verzeichnis für generierte Workshop-Dateien (Default: runtime_data/output)
# OUTPUT_DIR=./runtime_data/output
