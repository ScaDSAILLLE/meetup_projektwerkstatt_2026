# Text defaults: normalize line endings across workshop laptops and WSL.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary and model artefacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pptx binary
*.gguf binary
*.bin binary
*.safetensors binary
*.pt binary
*.pth binary
*.wav binary
*.mp3 binary
*.mp4 binary

uv.lock text eol=lf
*.md text eol=lf
